{
  "title": "DRE Agent",
  "uid": "dre-agent",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Events emitted",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(dre_events_emitted_total[5m])",
          "legendFormat": "events/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ringbuf drops",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(dre_ringbuf_drops_total[5m])",
          "legendFormat": "drops/s"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Bypass mode",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "dre_bypass_mode",
          "legendFormat": "bypass"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drop ratio",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rate(dre_ringbuf_drops_total[5m]) / (rate(dre_events_emitted_total[5m]) + rate(dre_ringbuf_drops_total[5m]) + 1e-9)",
          "legendFormat": "drop_pct"
        }
      ]
    }
  ]
}
