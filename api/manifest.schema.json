{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DRE Snapshot Manifest",
  "type": "object",
  "required": ["id", "cluster", "nodes", "trigger", "captured_at", "event_count", "checksum"],
  "properties": {
    "id": { "type": "string" },
    "cluster": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "trigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["manual", "http_5xx", "process_exit", "sigsegv"]
        },
        "detail": { "type": "string" }
      }
    },
    "captured_at": { "type": "string", "format": "date-time" },
    "event_count": { "type": "integer", "minimum": 0 },
    "checksum": { "type": "string" },
    "incident": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "root_cause": { "type": "string" },
        "services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "failed_step": { "type": "string" }
      }
    }
  },
  "definitions": {
    "sourceMap": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "file", "line"],
            "properties": {
              "index": { "type": "integer" },
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "column": { "type": "integer" },
              "function": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
