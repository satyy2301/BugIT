{
  "name": "bugit-dre",
  "displayName": "BugIT DRE Engine",
  "description": "Plug-and-play local bug capture and replay for any project",
  "version": "1.0.0",
  "publisher": "bugit",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/bugit/dre-engine.git"
  },
  "bugs": {
    "url": "https://gitlab.com/bugit/dre-engine/-/issues"
  },
  "homepage": "https://gitlab.com/bugit/dre-engine#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Debuggers", "Other"],
  "keywords": ["debug", "replay", "bug", "capture", "dre"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:bugit.loadSnapshot",
    "onCommand:bugit.fetchLatest",
    "onCommand:bugit.loadFromCollector",
    "onCommand:bugit.stepForward",
    "onCommand:bugit.stepBackward",
    "onCommand:bugit.attachDelve",
    "onCommand:bugit.startReplayDebug",
    "onCommand:bugit.stopReplay",
    "onCommand:bugit.openSourceAtEvent",
    "onCommand:bugit.openLatest",
    "onCommand:bugit.startCapture",
    "onCommand:bugit.startRecord",
    "onCommand:bugit.stopRecord",
    "onView:bugit.panel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bugit-sidebar",
          "title": "BugIT",
          "icon": "$(debug-alt)"
        }
      ]
    },
    "views": {
      "bugit-sidebar": [
        {
          "type": "webview",
          "id": "bugit.panel",
          "name": "BugIT"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "bugit.getStarted",
        "title": "Get Started with BugIT",
        "description": "Capture and replay bugs locally in minutes",
        "steps": [
          {
            "id": "openSidebar",
            "title": "Open BugIT sidebar",
            "description": "Click the BugIT icon in the activity bar — Record, Stop & Save, and Replay are one click away.",
            "media": { "markdown": "resources/walkthrough-install.md" }
          },
          {
            "id": "tryDemo",
            "title": "Try demo snapshot",
            "description": "Load the bundled checkout demo to see replay in action.",
            "completionEvents": ["onCommand:bugit.loadSnapshot"],
            "media": { "markdown": "resources/walkthrough-demo.md" }
          },
          {
            "id": "capture",
            "title": "Capture in your project",
            "description": "Click **Record** in the BugIT sidebar, use your app normally, then **Stop & Save**.",
            "completionEvents": ["onCommand:bugit.startRecord"],
            "media": { "markdown": "resources/walkthrough-capture.md" }
          },
          {
            "id": "jumpSource",
            "title": "Jump to source",
            "description": "Click an event, then run **DRE: Open Source at Current Event**.",
            "completionEvents": ["onCommand:bugit.openSourceAtEvent"],
            "media": { "markdown": "resources/walkthrough-source.md" }
          }
        ]
      }
    ],
    "configuration": {
      "title": "BugIT DRE",
      "properties": {
        "bugit.replayBin": {
          "type": "string",
          "default": "",
          "description": "Path to dre-replay binary (defaults to bundled binary)"
        },
        "bugit.bugitBin": {
          "type": "string",
          "default": "",
          "description": "Path to bugit binary (defaults to bundled binary)"
        },
        "bugit.captureRoot": {
          "type": "string",
          "default": "",
          "description": "Relative path to Node app root (e.g. backend). Auto-detected on first Record."
        },
        "bugit.devCommand": {
          "type": "string",
          "default": "npm run dev",
          "description": "Dev server command used during capture"
        },
        "bugit.publicPort": {
          "type": "number",
          "default": 4000,
          "description": "Public app port (proxy listens here during capture)"
        },
        "bugit.snapshotKey": {
          "type": "string",
          "default": "dev-insecure-key-change-me",
          "description": "AES key for decrypting .dre snapshots"
        },
        "bugit.replayConfig": {
          "type": "string",
          "default": "",
          "description": "Path to replay.yaml (defaults to .bugit/replay.yaml)"
        },
        "bugit.collectorUrl": {
          "type": "string",
          "default": "http://127.0.0.1:28080",
          "description": "DRE collector HTTP base URL for fetch/list"
        },
        "bugit.delveAddr": {
          "type": "string",
          "default": "127.0.0.1:2345",
          "description": "Delve headless listen address for attach"
        },
        "bugit.appBinary": {
          "type": "string",
          "default": "",
          "description": "Path to your app binary for Delve during replay (Go apps)"
        }
      }
    },
    "commands": [
      {
        "command": "bugit.loadSnapshot",
        "title": "DRE: Load Snapshot",
        "icon": "$(debug-restart)"
      },
      {
        "command": "bugit.openLatest",
        "title": "DRE: Open Latest Snapshot",
        "icon": "$(history)"
      },
      {
        "command": "bugit.startCapture",
        "title": "DRE: Start Capture",
        "icon": "$(record)"
      },
      {
        "command": "bugit.startRecord",
        "title": "BugIT: Record",
        "icon": "$(record)"
      },
      {
        "command": "bugit.stopRecord",
        "title": "BugIT: Stop and Save",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bugit.fetchLatest",
        "title": "DRE: Fetch Latest Snapshot"
      },
      {
        "command": "bugit.loadFromCollector",
        "title": "DRE: Load from Collector"
      },
      {
        "command": "bugit.stepForward",
        "title": "DRE: Step Forward",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "bugit.stepBackward",
        "title": "DRE: Step Backward",
        "icon": "$(debug-step-back)"
      },
      {
        "command": "bugit.attachDelve",
        "title": "DRE: Attach Delve"
      },
      {
        "command": "bugit.startReplayDebug",
        "title": "DRE: Start Replay Debug Session"
      },
      {
        "command": "bugit.stopReplay",
        "title": "DRE: Stop Replay"
      },
      {
        "command": "bugit.openSourceAtEvent",
        "title": "DRE: Open Source at Current Event"
      }
    ],
    "debuggers": [
      {
        "type": "bugit-dre",
        "label": "DRE Replay",
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "debugAddr": {
                "type": "string",
                "default": "127.0.0.1:19090",
                "description": "Replay debugger sync API address"
              }
            }
          }
        }
      }
    ],
    "keybindings": [
      {
        "command": "bugit.stepForward",
        "key": "f10",
        "when": "activeWebviewPanelId == bugitTimeline"
      },
      {
        "command": "bugit.stepBackward",
        "key": "shift+f10",
        "when": "activeWebviewPanelId == bugitTimeline"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/mermaid/dist/mermaid.min.js';if(fs.existsSync(p)){fs.mkdirSync('media',{recursive:true});fs.copyFileSync(p,'media/mermaid.min.js');}\""
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.65.0",
    "@vscode/debugprotocol": "^1.65.0",
    "mermaid": "^10.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3"
  }
}
